# ─────────────────────────────────────────────────────────
#  Smart Campus – Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Google OAuth2 (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# JWT secret – any long random string (32+ chars)
JWT_SECRET=YourSuperSecretJwtKeyAtLeast32CharsLong

# Frontend URL (do not change for local dev)
FRONTEND_URL=http://localhost:5173
